# Copie para .env antes de subir o compose. Os mesmos nomes sao validados na
# inicializacao da aplicacao (TASK-003) — ausencia derruba o processo, nao
# produz erro de conexao adiante.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=documentacao
