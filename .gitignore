# dependências
node_modules/

# build
dist/
build/
*.tsbuildinfo

# ambiente — nunca versionado
.env
.env.*
!.env.example

# cobertura de testes
coverage/

# artefatos do Playwright (TASK-069)
test-results/
playwright-report/

# husky (TASK-072): "_" e reconstruido por `npm install` (script "prepare"),
# so o hook em si (.husky/commit-msg) e entregavel.
.husky/_/

# dumps de banco — nunca versionados.
# *.sql não entra aqui: D-11 prevê SQL escrito à mão em migration.
*.dump
*.sql.gz
dumps/

# logs
*.log
npm-debug.log*

# SO e editor
.DS_Store
Thumbs.db
*.swp

# enunciado do desafio — material de terceiros (ver CLAUDE.md)
docs/desafio.md

# Claude Code: settings.json É versionado; só o override local fica de fora.
# NÃO ignorar .claude/ — a skill spec-flow faz parte da entrega e mostra
# como o trabalho foi conduzido. Templates padrão excluem este diretório.
.claude/settings.local.json
